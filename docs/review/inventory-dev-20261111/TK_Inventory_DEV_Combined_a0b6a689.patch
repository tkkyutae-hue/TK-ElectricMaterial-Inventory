+export function inventoryEditDiff<T extends object>(before: T, after: T) {
+  const changes: Partial<T> = {};
+  const expected: Partial<T> = {};
+  for (const key of Object.keys(after) as (keyof T)[]) {
+    if (Object.is(before[key], after[key])) continue;
+    changes[key] = after[key];
+    expected[key] = before[key];
+  }
+  return { changes, expected };
+}
+
+export type ReelEditFields = {
+  reelId: string;
+  lengthFt: number;
+  brand: string | null;
+  locationId: number | null;
+  status: string | null;
+};
+
+export type ReelEdit = {
+  id: number;
+  changes: Partial<ReelEditFields>;
+  expected: Partial<ReelEditFields>;
+};
+
+export class InventoryEditConflict extends Error {}
+
+export class CatalogAuditUnavailable extends Error {
+  readonly code = "CATALOG_AUDIT_UNAVAILABLE";
+  constructor() {
+    super("Catalog saving is unavailable because database audit permissions are incomplete. Contact an administrator.");
+  }
+}
+
+export function checkInventoryEdit(current: object, expected: object, message: string) {
+  const row = current as Record<string, unknown>;
+  if (Object.entries(expected).some(([key, value]) => !Object.is(row[key], value))) {
+    throw new InventoryEditConflict(message);
+  }
+}
+
+export function normalizeInventorySku(value: string) {
+  return value.trim().toUpperCase();
+}
+
+export class InventorySkuConflict extends Error {
+  constructor(readonly itemId: number) {
+    super("This SKU is already assigned to an item.");
+  }
+}
+
+export type CatalogCommand = {
+  branchId: "savannah" | "indiana";
+  operationId: string;
+  actorUserId: string;
+  reason?: string;
+};
+
+export type CatalogOperationResult = { itemIds: number[] };
+
+// Reuse the ID when retrying an unchanged edit after a lost response.
+export function catalogOperationId(
+  slot: { current: { payload: string; id: string } | null },
+  body: object,
+) {
+  const payload = JSON.stringify(body);
+  if (slot.current?.payload !== payload) {
+    slot.current = { payload, id: globalThis.crypto.randomUUID() };
+  }
+  return slot.current.id;
+}
+
+export function isAssetTrackingCategory(categoryName: string | null | undefined): boolean {
+  return categoryName?.trim().toUpperCase() === "TOOLS & ASSETS";
+}
