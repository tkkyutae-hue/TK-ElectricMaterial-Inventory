diff --git a/client/src/components/shared/useSearchPicker.ts b/client/src/components/shared/useSearchPicker.ts
new file mode 100644
index 0000000000000000000000000000000000000000..f24fa327cf4a3d45c4c472782a04cee4bc4c25a2
--- /dev/null
+++ b/client/src/components/shared/useSearchPicker.ts
@@ -0,0 +1,175 @@
+import { useEffect, useId, useLayoutEffect, useState } from "react";
+import type { KeyboardEvent, RefObject } from "react";
+import "./searchPicker.css";
+
+export function normalizePickerSearch(value: string) {
+  return value.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase().trim().replace(/\s+/g, " ");
+}
+
+export function placePicker(
+  anchor: { top: number; bottom: number; left: number; width: number },
+  viewport: { top: number; bottom: number; width: number },
+) {
+  const gap = 4;
+  const inset = 8;
+  const below = viewport.bottom - inset - anchor.bottom - gap;
+  const above = anchor.top - gap - viewport.top - inset;
+  const opensAbove = below < 320 && above > below;
+  const width = Math.max(0, Math.min(anchor.width, viewport.width - inset * 2));
+  return {
+    top: opensAbove ? undefined : anchor.bottom + gap,
+    bottom: opensAbove ? anchor.top - gap : undefined,
+    left: Math.max(inset, Math.min(anchor.left, viewport.width - width - inset)),
+    width,
+    maxHeight: Math.max(0, Math.min(320, opensAbove ? above : below)),
+  };
+}
+
+export function useSearchPicker({
+  open, mobile, fixed, anchor, panel, query, close,
+}: {
+  open: boolean;
+  mobile: boolean;
+  fixed: boolean;
+  anchor: RefObject<HTMLDivElement>;
+  panel: RefObject<HTMLDivElement>;
+  query: string;
+  close: () => void;
+}) {
+  const listId = useId();
+  const [activeId, setActiveId] = useState<string>();
+  const [position, setPosition] = useState<ReturnType<typeof placePicker> | null>(null);
+  const [sheet, setSheet] = useState<{ bottom: number; maxHeight: number }>();
+
+  useLayoutEffect(() => {
+    if (!open || (!fixed && !mobile)) return;
+    const update = () => {
+      const trigger = anchor.current;
+      if (!trigger) return;
+      const visual = window.visualViewport;
+      const top = visual?.offsetTop ?? 0;
+      const height = visual?.height ?? window.innerHeight;
+      if (mobile) {
+        setSheet({ bottom: Math.max(0, window.innerHeight - top - height), maxHeight: Math.floor(height * 0.82) });
+        return;
+      }
+      const footer = trigger.closest("form")?.querySelector("[data-movement-footer]")?.getBoundingClientRect();
+      const footerTop = footer && footer.top >= top && footer.top < top + height ? footer.top : top + height;
+      const bounds = trigger.getBoundingClientRect();
+      const placement = placePicker(bounds, { top, bottom: footerTop, width: window.innerWidth });
+      setPosition({ ...placement, bottom: placement.bottom === undefined ? undefined : window.innerHeight - placement.bottom });
+    };
+    update();
+    const visual = window.visualViewport;
+    const onScroll = (event: Event) => {
+      if (!(event.target instanceof Node) || !panel.current?.contains(event.target)) update();
+    };
+    window.addEventListener("resize", update);
+    window.addEventListener("scroll", onScroll, true);
+    visual?.addEventListener("resize", update);
+    visual?.addEventListener("scroll", update);
+    const footer = anchor.current?.closest("form")?.querySelector("[data-movement-footer]");
+    const observer = typeof ResizeObserver === "undefined" ? undefined : new ResizeObserver(update);
+    if (anchor.current) observer?.observe(anchor.current);
+    if (footer) observer?.observe(footer);
+    return () => {
+      window.removeEventListener("resize", update);
+      window.removeEventListener("scroll", onScroll, true);
+      visual?.removeEventListener("resize", update);
+      visual?.removeEventListener("scroll", update);
+      observer?.disconnect();
+    };
+  }, [open, mobile, fixed, anchor, panel]);
+
+  useEffect(() => {
+    setActiveId(undefined);
+  }, [open, query]);
+
+  useEffect(() => {
+    if (!open) return;
+    panel.current?.querySelector('[role="option"][aria-selected="true"]')?.scrollIntoView({ block: "nearest" });
+  }, [open, panel]);
+
+  useEffect(() => {
+    if (!open || !mobile) return;
+    const previousOverflow = document.body.style.overflow;
+    document.body.style.overflow = "hidden";
+    return () => { document.body.style.overflow = previousOverflow; };
+  }, [open, mobile]);
+
+  function dismiss(restoreFocus = false) {
+    close();
+    if (restoreFocus) requestAnimationFrame(() => anchor.current?.querySelector<HTMLElement>("[data-picker-trigger]")?.focus());
+  }
+
+  function option(key: string | number, selected: boolean) {
+    const id = listId + "-" + key;
+    return {
+      id,
+      role: "option" as const,
+      tabIndex: -1,
+      "aria-selected": selected,
+      "data-picker-active": activeId === id ? "true" : undefined,
+      "data-picker-option": "",
+    };
+  }
+
+  function onKeyDown(event: KeyboardEvent<HTMLElement>) {
+    if (event.defaultPrevented || event.nativeEvent.isComposing || event.keyCode === 229) return;
+    if (event.key === "Escape") {
+      event.preventDefault();
+      event.stopPropagation();
+      dismiss(true);
+      return;
+    }
+    if (event.key === "Tab" && mobile) {
+      const controls = Array.from(panel.current?.querySelectorAll<HTMLElement>(
+        'input:not([disabled]), button:not([disabled]):not([tabindex="-1"]), a[href]',
+      ) ?? []);
+      const edge = event.shiftKey ? controls[0] : controls[controls.length - 1];
+      if (edge && event.target === edge) {
+        event.preventDefault();
+        (event.shiftKey ? controls[controls.length - 1] : controls[0])?.focus();
+      }
+      return;
+    }
+    if (event.key === "Tab") {
+      // Preserve native Tab order while the input is still mounted.
+      requestAnimationFrame(() => {
+        if (!anchor.current?.contains(document.activeElement) && !panel.current?.contains(document.activeElement)) dismiss();
+      });
+      return;
+    }
+    if (!(event.target instanceof HTMLInputElement)) return;
+    const choices = Array.from(panel.current?.querySelectorAll<HTMLButtonElement>("[data-picker-option]") ?? []);
+    const index = choices.findIndex(choice => choice.id === activeId);
+    if (event.key === "Enter") {
+      event.preventDefault();
+      choices[index]?.click();
+    } else if ((event.key === "ArrowDown" || event.key === "ArrowUp") && choices.length) {
+      event.preventDefault();
+      const step = event.key === "ArrowDown" ? 1 : -1;
+      const next = index === -1
+        ? choices[step === 1 ? 0 : choices.length - 1]
+        : choices[(index + step + choices.length) % choices.length];
+      setActiveId(next.id);
+      next.scrollIntoView({ block: "nearest" });
+    }
+  }
+
+  return {
+    position: position ?? { visibility: "hidden" as const },
+    sheet,
+    list: { id: listId, role: "listbox" as const },
+    input: {
+      role: "combobox" as const,
+      "aria-expanded": open,
+      "aria-controls": listId,
+      "aria-activedescendant": activeId,
+      "aria-autocomplete": "list" as const,
+    },
+    option,
+    onKeyDown,
+    dismiss,
+  };
+}
diff --git a/client/src/lib/catalogFamily.ts b/client/src/lib/catalogFamily.ts
new file mode 100644
index 0000000000000000000000000000000000000000..8d28c1f8ef22daabada431c42a03707b445d6c48
--- /dev/null
+++ b/client/src/lib/catalogFamily.ts
@@ -0,0 +1,25 @@
+import { branchFetch } from "@/lib/branchTransport";
+import { catalogOperationId, type CatalogOperationResult } from "@shared/inventoryEdit";
+
+export async function submitCatalogFamily(
+  categoryId: number,
+  operation: { current: { payload: string; id: string } | null },
+  payload: object,
+): Promise<CatalogOperationResult | null> {
+  const operationId = catalogOperationId(operation, { categoryId, payload });
+  const response = await branchFetch(`/api/inventory/category/${categoryId}/catalog-family`, {
+    method: "POST",
+    credentials: "include",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ ...payload, operationId }),
+  });
+  const data = await response.json();
+  // The capability response is emitted before the server starts a mutation.
+  if (response.status === 501 && data.code === "CATALOG_V3_UNAVAILABLE") return null;
+  if (!response.ok) {
+    throw Object.assign(new Error(data.message || `Save failed (${response.status}).`), {
+      existingItemId: response.status === 409 && Number.isSafeInteger(data.itemId) ? data.itemId : undefined,
+    });
+  }
+  return data;
+}
diff --git a/client/src/lib/inventoryReturnTo.ts b/client/src/lib/inventoryReturnTo.ts
new file mode 100644
index 0000000000000000000000000000000000000000..07b54bd3dd23c0d567c3dbacda852e41aa2b84bb
--- /dev/null
+++ b/client/src/lib/inventoryReturnTo.ts
@@ -0,0 +1,29 @@
+export function safeInventoryReturnTo(raw: string | null): string {
+  if (!raw || !raw.startsWith("/inventory") || raw.startsWith("//")) return "/inventory";
+  try {
+    const base = "https://tk-inventory.invalid";
+    const candidate = new URL(raw, base);
+    if (candidate.origin !== base || candidate.pathname !== "/inventory") return "/inventory";
+    const source = candidate.searchParams;
+    const allowed = new URLSearchParams();
+    const query = source.get("q");
+    if (query && query.length <= 160) allowed.set("q", query);
+    const status = source.get("status");
+    if (status && ["in_stock", "low_stock", "out_of_stock"].includes(status)) allowed.set("status", status);
+    const category = source.get("category");
+    if (category && /^\d{1,9}$/.test(category)) allowed.set("category", category);
+    const usage = source.get("usage");
+    if (usage && ["core", "normal", "low", "none"].includes(usage)) allowed.set("usage", usage);
+    const page = source.get("page");
+    if (page && /^[1-9]\d{0,5}$/.test(page) && Number(page) <= 100000) allowed.set("page", page);
+    const perPage = source.get("perPage");
+    if (perPage && ["5", "10", "15", "25", "50", "100"].includes(perPage)) allowed.set("perPage", perPage);
+    const sort = source.get("sort");
+    if (sort && ["name", "sku", "quantityOnHand", "status"].includes(sort)) allowed.set("sort", sort);
+    if (source.get("dir") === "desc") allowed.set("dir", "desc");
+    const queryString = allowed.toString();
+    return `/inventory${queryString ? `?${queryString}` : ""}`;
+  } catch {
+    return "/inventory";
+  }
+}
